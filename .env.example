# Copy to .env and fill in. Never commit .env.
# docker compose reads .env from this folder automatically. For `go run`,
# export the variables first, e.g. `set -a; . ./.env; set +a`.

# Admin API and dashboard bearer token. Use a long random value, e.g. `openssl rand -hex 32`.
GATEWAY_ADMIN_TOKEN=

# Host port for the compose stack (default 8080).
GATEWAY_PORT=8080

# Config file for `gateway serve` when -config isn't given (default gateway.yaml).
GATEWAY_CONFIG=gateway.yaml

# Referenced from gateway.example.yaml. The compose stack sets these for its own containers.
GATEWAY_POSTGRES_URL=postgres://gateway:gateway@localhost:5432/gateway
GATEWAY_REDIS_URL=redis://localhost:6379/0

# Provider keys, referenced from gateway.example.yaml. Leave empty for the mock-provider demo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Integration tests only. Use a throwaway database and Redis DB; the tests write to them.
GATEWAY_TEST_POSTGRES=
GATEWAY_TEST_REDIS=
